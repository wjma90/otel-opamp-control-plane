{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "O11y Control Plane Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "service",
    "opampPublicService",
    "opampTls",
    "config",
    "database",
    "auth",
    "saml",
    "validator",
    "tmp",
    "probes"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "selectorLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "istio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sidecarInjection"
      ],
      "properties": {
        "sidecarInjection": {
          "type": "boolean"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "annotations",
        "uiPort",
        "opampPort"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "uiPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "opampPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "opampPublicService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "type",
        "annotations",
        "port",
        "nodePort"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 30000,
              "maximum": 32767
            }
          ]
        }
      }
    },
    "opampTls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingSecret",
        "certKey",
        "privateKeyKey"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "certKey": {
          "type": "string",
          "minLength": 1
        },
        "privateKeyKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opampAuthMode",
        "serverPublicURL",
        "opampPublicURL",
        "trustedProxyCIDRs",
        "collectorValidatorVersion"
      ],
      "properties": {
        "opampAuthMode": {
          "type": "string",
          "enum": [
            "disabled",
            "token"
          ]
        },
        "serverPublicURL": {
          "type": "string",
          "minLength": 1
        },
        "opampPublicURL": {
          "type": "string",
          "pattern": "/v1/opamp$"
        },
        "trustedProxyCIDRs": {
          "type": "string"
        },
        "collectorValidatorVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "urlKey"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master",
        "signing",
        "opampToken"
      ],
      "properties": {
        "master": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret",
            "usernameKey",
            "passwordKey"
          ],
          "properties": {
            "existingSecret": {
              "type": "string",
              "minLength": 1
            },
            "usernameKey": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret",
            "key"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "opampToken": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret",
            "key"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "saml": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingSecret",
        "certKey",
        "privateKeyKey",
        "certManager"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "certKey": {
          "type": "string",
          "minLength": 1
        },
        "privateKeyKey": {
          "type": "string",
          "minLength": 1
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "createIssuer",
            "secretName",
            "commonName",
            "duration",
            "renewBefore",
            "privateKey",
            "issuerRef"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "createIssuer": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            },
            "commonName": {
              "type": "string",
              "minLength": 1
            },
            "duration": {
              "type": "string",
              "minLength": 2
            },
            "renewBefore": {
              "type": "string",
              "minLength": 2
            },
            "privateKey": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "algorithm",
                "encoding",
                "size",
                "rotationPolicy"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "RSA",
                    "ECDSA"
                  ]
                },
                "encoding": {
                  "type": "string",
                  "enum": [
                    "PKCS1",
                    "PKCS8"
                  ]
                },
                "size": {
                  "type": "integer",
                  "minimum": 256
                },
                "rotationPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "Never"
                  ]
                }
              }
            },
            "issuerRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kind",
                "group"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "Issuer",
                    "ClusterIssuer"
                  ]
                },
                "group": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedEnvironment",
        "kubernetesSandbox",
        "hostfs"
      ],
      "properties": {
        "allowedEnvironment": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[^\\r\\n]+$"
              }
            }
          }
        },
        "kubernetesSandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rootCAConfigMapName",
            "namespace"
          ],
          "properties": {
            "rootCAConfigMapName": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 63
            }
          }
        },
        "hostfs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "mountPath",
            "sizeLimit"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mountPath": {
              "type": "string",
              "pattern": "^/"
            },
            "sizeLimit": {
              "type": "string"
            }
          }
        }
      }
    },
    "tmp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mountPath",
        "sizeLimit",
        "medium"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "sizeLimit": {
          "type": "string"
        },
        "medium": {
          "type": "string",
          "enum": [
            "",
            "Memory"
          ]
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readiness",
        "liveness"
      ],
      "properties": {
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "path",
        "initialDelaySeconds",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
